{
	"biome.enabled": true,
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"javascript.format.enable": true,
	"javascript.suggest.autoImports": true,
	"javascript.suggest.paths": true,
	"typescript.format.enable": true,
	"typescript.suggest.paths": true,
	"typescript.suggest.autoImports": true,
	"editor.renderWhitespace": "all",
	"editor.codeActionsOnSave": {
		"source.fixAll": "always",
		"source.organizeImports": "never",
		"source.organizeImports.biome": "always",
		"quickfix.biome": "always"
	},
	"editor.insertSpaces": false,
	"editor.detectIndentation": true,
	"editor.trimAutoWhitespace": true,
	"files.trimTrailingWhitespace": true,
	"files.trimTrailingWhitespaceInRegexAndStrings": true,
	"files.trimFinalNewlines": true,
	"explorer.fileNesting.patterns": {
		"*.ts": "${basename}.*.${extname}",
		".env": ".env.*",
		"*.tsx": "${basename}.*.${extname},${basename}.*.ts",
		"package.json": "*.json, *.yml, *.config.js, *.config.ts, *.yaml"
	},
	"eslint.enable": true,
	"eslint.format.enable": true,
	"prettier.enable": true,
	"editor.fontLigatures": true,
	"editor.fontSize": 14,
	"editor.lineHeight":2,
	"editor.wordWrap": "on",
	"editor.fontWeight": "500",
	"editor.tabSize": 2,
	"editor.minimap.enabled": false,
	"editor.suggestSelection": "first",
	"editor.suggest.showKeywords": true,
	"editor.suggest.showSnippets": true,
	"editor.suggest.showIcons": true,
	"editor.suggest.showStatusBar": true,
	"editor.suggest.showMethods": true,
	"editor.suggest.showFunctions": true,
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"github.copilot.enable": true,
	"github.copilot.inlineSuggest.enable": true,
	"github.copilot.suggestionDelayMs": 100,
	"github.copilot.advanced": {
		"inlineSuggestCount": 3,
		"panel.enabled": true
	},
	"github.copilot.editor.enableAutoCompletions": true,
	"github.copilot.editor.enableAutoCompletionsForAllLanguages": true,
	"github.copilot.chat.agent.thinkingTool": true,
	"github.copilot.chat.codeGeneration.useInstructionFiles": true
}
